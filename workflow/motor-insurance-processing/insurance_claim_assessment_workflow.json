      "name": "publish_claim_approved_event",
      "taskReferenceName": "publish_claim_approved_event",
      "description": "Publish the canonical claim.approved event to Oracle TxEventQ.",
      "inputParameters": {
        "databaseProfile": "insurance_database",
        "topic": "insurance_claim_queue",
        "publisherAgentName": "approvalAgent",
