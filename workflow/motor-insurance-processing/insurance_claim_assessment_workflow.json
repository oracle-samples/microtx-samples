    {
      "name": "serialize_claim_approved_event",
      "taskReferenceName": "serialize_claim_approved_event",
      "description": "Build the stable claim.approved event contract and serialize it as JSON text for TxEventQ.",
      "inputParameters": {
        "data": {
          "eventType": "claim.approved",
          "eventVersion": "1.0",
          "eventId": "${workflow.input.claimDetails.approvalEventId}",
          "correlationId": "${workflow.input.claimDetails.correlationId}",
          "causationId": "${workflow.input.claimDetails.causationId}",
          "occurredAt": "${workflow.input.claimDetails.occurredAt}",
          "data": {
            "claimId": "${workflow.input.claimDetails.claimId}",
            "approvedAmount": "${human_review.output.approvedAmount}",
            "approvalType": "${human_review.output.approvalType}"
          }
        },
        "queryExpression": ".data | tojson"
      },
      "type": "JSON_JQ_TRANSFORM",
      "decisionCases": {},
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "onStateChange": {},
      "permissive": false
    },
