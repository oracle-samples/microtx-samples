    {
      "name": "validate_claim",
      "taskReferenceName": "validate_claim",
      "description": "Application Service: result=true means the claim and policy checks pass; result=false rejects the claim.",
      "inputParameters": {
        "uri": "${workflow.input.config.serviceBaseUrl}/claims/validate",
        "method": "POST",
        "accept": "application/json",
        "contentType": "application/json",
        "headers": {
          "x-mock-response-name": "${workflow.input.config.validationMockResponse}"
        },
        "body": {
          "claimId": "${workflow.input.claimDetails.claimId}",
          "correlationId": "${workflow.input.claimDetails.correlationId}",
          "claim": {
            "policyId": "${workflow.input.claimDetails.claim.policyId}",
            "claimant": {
              "customerId": "${workflow.input.claimDetails.claim.claimant.customerId}",
              "name": "${workflow.input.claimDetails.claim.claimant.name}"
            },
            "vehicle": {
              "registrationNumber": "${workflow.input.claimDetails.claim.vehicle.registrationNumber}",
              "make": "${workflow.input.claimDetails.claim.vehicle.make}",
              "model": "${workflow.input.claimDetails.claim.vehicle.model}",
              "year": "${workflow.input.claimDetails.claim.vehicle.year}"
            },
            "incident": {
              "date": "${workflow.input.claimDetails.claim.incident.date}",
              "type": "${workflow.input.claimDetails.claim.incident.type}",
              "location": "${workflow.input.claimDetails.claim.incident.location}",
              "description": "${workflow.input.claimDetails.claim.incident.description}"
            },
            "requestedAmount": "${workflow.input.claimDetails.claim.requestedAmount}",
            "currency": "${workflow.input.claimDetails.claim.currency}",
            "documents": "${workflow.input.claimDetails.claim.documents}"
          }
        },
        "connectionTimeOut": 5000,
        "readTimeOut": 10000
      },
      "type": "HTTP",
      "decisionCases": {},
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "onStateChange": {},
      "permissive": false
    },
    {
      "name": "validation_decision",
      "taskReferenceName": "validation_decision",
      "description": "Continue when the result matches true; otherwise terminate with a business rejection through the default case.",
      "inputParameters": {
        "result": "${validate_claim.output.response.body.result}"
      },
      "type": "SWITCH",
      "decisionCases": {
        "true": [
          {
            "name": "validation_passed",
            "taskReferenceName": "validation_passed",
            "inputParameters": {
              "claimStatus": "VALIDATED"
            },
            "type": "SET_VARIABLE",
            "decisionCases": {},
            "defaultCase": [],
            "forkTasks": [],
            "startDelay": 0,
            "joinOn": [],
            "optional": false,
            "defaultExclusiveJoinTask": [],
            "asyncComplete": false,
            "loopOver": [],
            "onStateChange": {},
            "permissive": false
          }
        ]
      },
      "defaultCase": [
        {
          "name": "validation_rejected",
          "taskReferenceName": "validation_rejected",
          "inputParameters": {
            "terminationStatus": "COMPLETED",
            "terminationReason": "CLAIM_VALIDATION_FAILED",
            "workflowOutput": {
              "claimId": "${workflow.input.claimDetails.claimId}",
              "status": "REJECTED",
              "reason": "CLAIM_VALIDATION_FAILED",
              "correlationId": "${workflow.input.claimDetails.correlationId}"
            }
          },
          "type": "TERMINATE",
          "decisionCases": {},
          "defaultCase": [],
          "forkTasks": [],
          "startDelay": 0,
          "joinOn": [],
          "optional": false,
          "defaultExclusiveJoinTask": [],
          "asyncComplete": false,
          "loopOver": [],
          "onStateChange": {},
          "permissive": false
        }
      ],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "evaluatorType": "value-param",
      "expression": "result",
      "onStateChange": {},
      "permissive": false
    },
