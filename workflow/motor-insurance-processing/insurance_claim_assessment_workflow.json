    {
      "name": "human_review",
      "taskReferenceName": "human_review",
      "description": "Wait for an adjuster decision. Complete with approved (boolean), approvedAmount, approvalType=MANUAL, and reviewerId. A false decision rejects the claim.",
      "inputParameters": {
        "claimId": "${workflow.input.claimDetails.claimId}",
        "claim": "${validate_claim.output.response.body.claim}",
        "fraudCheck": "${fraud_check.output.response.body}",
        "requestedAmount": "${validate_claim.output.response.body.claim.requestedAmount}",
        "currency": "${validate_claim.output.response.body.claim.currency}",
        "formData": {
          "approved": false,
          "approvedAmount": "${workflow.input.claimDetails.claim.requestedAmount}",
          "approvalType": "MANUAL",
          "reviewerId": "adjuster-demo"
        },
        "ai_evaluator": "${insurance_assessor.output}"
