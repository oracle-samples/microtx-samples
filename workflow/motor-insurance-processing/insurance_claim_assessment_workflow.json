      "taskReferenceName": "insurance_assessor",
      "inputParameters": {
        "agentProfile": "insurance_agent",
        "prompt": "The claim information ${validate_claim.output.response.body} and request status ${validate_claim.output.response.statusCode}",
        "promptVariables": {},
        "temperature": 0.8,
        "maxTokens": 1024,
        "top_k": 40,
        "top_p": 0.9,
        "idempotencyLockTimeout": 180000
