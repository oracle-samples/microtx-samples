    {
      "name": "persist_approval",
      "taskReferenceName": "persist_approval",
      "description": "Insert a new demo approval row on every execution. Duplicate claim IDs are allowed; Oracle generates the approval row ID.",
      "inputParameters": {
        "databaseProfile": "insurance_database",
        "type": "UPDATE",
        "sqlStatement": "INSERT INTO CLAIM_APPROVALS (CLAIM_ID, APPROVED_AMOUNT, APPROVAL_TYPE, REVIEWER_ID, STATUS, UPDATED_AT) VALUES (?, ?, ?, ?, 'APPROVED', SYSTIMESTAMP)",
        "parameters": [
          "${workflow.input.claimDetails.claimId}",
          "${human_review.output.approvedAmount}",
          "${human_review.output.approvalType}",
          "${human_review.output.reviewerId}"
        ],
        "enableIdempotency": true,
        "idempotentTableName": "fenced_task_idempotency_lock"
      },
