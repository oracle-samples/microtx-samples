    "paymentIdempotencyKey",
    "serviceBaseUrl",
    "paymentMockResponse",
    "paymentStatusMockResponse"
  ],
  "outputParameters": {
    "claimId": "${workflow.input.claimId}",
    "status": "SETTLED",
    "approvedAmount": "${normalize_settlement_input.output.result.approvedAmount}",
    "paymentId": "${workflow.variables.payment.paymentId}",
    "paymentStatus": "${workflow.variables.payment.paymentStatus}",
    "eventId": "evt-${workflow.workflowId}-settled",
    "correlationId": "${workflow.input.correlationId}",
    "publishTaskResponse": "${publish_claim_settled_event.output.response}",
    "pollCount": "${poll_payment_status.output.iteration}"
  },
  "schemaVersion": 2,
  "restartable": true,
