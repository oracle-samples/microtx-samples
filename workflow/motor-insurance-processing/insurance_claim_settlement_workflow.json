    },
    {
      "name": "serialize_claim_settled_event",
      "taskReferenceName": "serialize_claim_settled_event",
      "description": "Serialize the final claim.settled event after confirmed payment.",
      "inputParameters": {
        "data": {
          "eventType": "claim.settled",
          "eventVersion": "1.0",
          "eventId": "evt-${workflow.workflowId}-settled",
          "occurredAt": "${workflow.variables.payment.completedAt}",
          "correlationId": "${workflow.input.correlationId}",
          "causationId": "${workflow.input.causationId}",
          "data": {
            "claimId": "${workflow.input.claimId}",
            "settledAmount": "${normalize_settlement_input.output.result.approvedAmount}",
            "currency": "INR",
            "paymentId": "${workflow.variables.payment.paymentId}",
            "paymentStatus": "${workflow.variables.payment.paymentStatus}"
          }
        },
        "queryExpression": ".data | tojson"
      },
      "type": "JSON_JQ_TRANSFORM",
      "decisionCases": {},
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "onStateChange": {},
      "permissive": false
    },
    {
      "name": "publish_claim_settled_event",
      "taskReferenceName": "publish_claim_settled_event",
      "description": "Publish claim.settled to insurance_settlement_queue for settlementAgent.",
      "inputParameters": {
        "databaseProfile": "insurance_database",
        "topic": "insurance_settlement_queue",
        "publisherAgentName": "settlement_agent",
        "value": "${serialize_claim_settled_event.output.result}"
      },
      "type": "TXEVENTQ_PUBLISH",
      "decisionCases": {},
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "onStateChange": {},
