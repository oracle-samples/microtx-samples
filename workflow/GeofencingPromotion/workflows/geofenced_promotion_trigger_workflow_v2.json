                    "databaseProfile": "oracle-db-profile",
                    "sqlStatement": "INSERT INTO notification (\n    user_id,\n    payload,\n    created_at\n  )\n  VALUES (\n    ?,\n    JSON_OBJECT(\n      'createdTime' VALUE SYSTIMESTAMP,\n      'message'     VALUE ?\n    ),\n    SYSDATE\n  );",
                    "parameters": [
                      "${workflow.input.userId}",
                      "${rewrite_promotion_message_ref.output.response}"
