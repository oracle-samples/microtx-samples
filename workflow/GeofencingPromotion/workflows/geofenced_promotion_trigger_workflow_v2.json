        "databaseProfile": "oracle-db-profile",
        "sqlStatement": "DECLARE\n  v_event_id    NUMBER;\n  v_geofence_id NUMBER;\n  v_match_flag  VARCHAR2(3);\nBEGIN\n  sp_check_geofence_containment(\n    p_event_id    => ?,\n    p_geofence_id => v_geofence_id,\n    p_match_flag  => v_match_flag\n  );\n  ? := v_geofence_id;\n  ? := v_match_flag;\nEND;",
        "outParams": {
          "p_geofence_id": "NUMBER",
          "p_match_flag": "CHAR"
        },
        "type": "PLSQL",
        "plSqlParameters": [
          {
            "mode": "IN",
            "value": "${workflow.input.eventId}"
          },
          {
            "mode": "OUT",
            "name": "p_geofence_id",
            "dataType": "NUMERIC"
          },
          {
            "mode": "OUT",
            "name": "p_match_flag",
            "dataType": "CHAR"
          }
        ]
      },
      "type": "SQL",
      "decisionCases": {},
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "onStateChange": {},
      "permissive": false
    },
