              "parameters": [],
              "type": "PLSQL",
              "plSqlParameters": [
                {
                  "mode": "IN",
                  "value": "${workflow.input.eventId}"
                },
                {
                  "mode": "IN",
                  "value": "${workflow.input.userId}"
                },
                {
                  "mode": "IN",
                  "value": "${check_geofence_ref.output.response.outParameters.p_geofence_id}"
                },
                {
                  "mode": "OUT",
                  "name": "p_promotion_id",
                  "dataType": "NUMERIC"
                },
                {
                  "mode": "OUT",
                  "name": "p_eligible_flag",
                  "dataType": "CHAR"
                },
                {
                  "mode": "OUT",
                  "name": "p_reason",
                  "dataType": "VARCHAR"
                }
              ]
            },
            "type": "SQL",
            "decisionCases": {},
            "defaultCase": [],
            "forkTasks": [],
            "startDelay": 0,
            "joinOn": [],
            "optional": false,
            "defaultExclusiveJoinTask": [],
            "asyncComplete": false,
            "loopOver": [],
            "onStateChange": {},
            "permissive": false
          },
          {
            "name": "log_geofence_and_eligibility_event",
            "taskReferenceName": "log_event_ref",
            "inputParameters": {
              "databaseProfile": "oracle-db-profile",
              "sqlStatement": "DECLARE\n  v_event_id      NUMBER := ?;\n  v_user_id       NUMBER := ?;\n  v_geofence_id   NUMBER := ?;\n  v_promotion_id  NUMBER := ?;\n  v_eligible_flag VARCHAR2(3) := ?;\n  v_reason        VARCHAR2(4000) := ?;\n\n  v_action_taken  VARCHAR2(30);\nBEGIN\n  v_action_taken := CASE WHEN v_eligible_flag = 'Yes' THEN 'ELIGIBLE' ELSE 'NOT_ELIGIBLE' END;\n\n  sp_log_promotion_event(\n    p_event_id     => v_event_id,\n    p_user_id      => v_user_id,\n    p_geofence_id  => v_geofence_id,\n    p_promotion_id => v_promotion_id,\n    p_action_taken => v_action_taken,\n    p_details      => v_reason\n  );\nEND;",
              "parameters": [],
              "type": "PLSQL",
              "plSqlParameters": [
                {
                  "mode": "IN",
                  "value": "${workflow.input.eventId}"
                },
                {
                  "mode": "IN",
                  "value": "${workflow.input.userId}"
