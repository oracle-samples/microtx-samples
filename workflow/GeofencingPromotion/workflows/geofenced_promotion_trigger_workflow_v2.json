                    "sqlStatement": "DECLARE\n  v_user_id   NUMBER := ?;\n  v_name      VARCHAR2(4000);\n  v_tier      VARCHAR2(4000);\n  v_opted_in  VARCHAR2(3);\nBEGIN\n  sp_load_user_promo_context(\n    p_user_id      => v_user_id,\n    p_user_name    => v_name,\n    p_loyalty_tier => v_tier,\n    p_opted_in     => v_opted_in\n  );\n  ? := v_name;\n  ? := v_tier;\n  ? := v_opted_in;\nEND;",
                    "parameters": [],
                    "type": "PLSQL",
                    "plSqlParameters": [
                      {
                        "mode": "IN",
