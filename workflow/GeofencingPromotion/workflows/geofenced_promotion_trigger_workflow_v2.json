                },
                {
                  "mode": "IN",
                  "value": "${evaluate_eligibility_ref.output.response.outParameters.p_reason}"
                }
              ]
            },
            "type": "SQL",
            "decisionCases": {},
            "defaultCase": [],
            "forkTasks": [],
            "startDelay": 0,
            "joinOn": [],
            "optional": false,
            "defaultExclusiveJoinTask": [],
            "asyncComplete": false,
            "loopOver": [],
            "onStateChange": {},
            "permissive": false
          },
